class PersistentTuyaBasicCluster(Basic):
    """Basic cluster that maintains persistent firmware information."""
    
    def __init__(self, *args, **kwargs):
        """Initialize with persistent firmware cache."""
        super().__init__(*args, **kwargs)
        self._persistent_firmware = {}
        
    async def read_attributes(self, attributes, *args, **kwargs):
        """Override to provide persistent firmware attributes."""
        result = await super().read_attributes(attributes, *args, **kwargs)
        
        # If we have cached firmware info, ensure it's always returned
        if result and isinstance(result, tuple) and len(result) > 0:
            attr_dict = result[0]
            
            # For firmware-related attributes, use cached values if available
            firmware_attrs = ['app_version', 'sw_build_id', 'hw_version', 'date_code']
            for attr_name in firmware_attrs:
                if hasattr(self.attributes_by_name, attr_name):
                    attr_id = self.attributes_by_name[attr_name].id
                    
                    # If this attribute was requested and we have a cached value
                    if attr_id in attributes and attr_name in self._persistent_firmware:
                        cached_value = self._persistent_firmware[attr_name]
                        if cached_value is not None:
                            attr_dict[attr_id] = cached_value
                            _LOGGER.debug("🔒 Using persistent %s: %s", attr_name, cached_value)
        
        return result
    
    def _update_attribute(self, attrid, value):
        """Override to cache firmware attributes persistently."""
        super()._update_attribute(attrid, value)
        
        # Cache firmware-related attributes
        firmware_attrs = {
            self.attributes_by_name.get('app_version', {}).id: 'app_version',
            self.attributes_by_name.get('sw_build_id', {}).id: 'sw_build_id', 
            self.attributes_by_name.get('hw_version', {}).id: 'hw_version',
            self.attributes_by_name.get('date_code', {}).id: 'date_code',
        }
        
        if attrid in firmware_attrs and value is not None:
            attr_name = firmware_attrs[attrid]
            self._persistent_firmware[attr_name] = value
            _LOGGER.info("🔒 Cached persistent firmware: %s = %s", attr_name, value)


class TuyaBlindControllerManufCluster(TuyaManufacturerWindowCover):
    """Enhanced manufacturer cluster that coordinates with ZCL attributes."""
    
    def __init__(self, *args, **kwargs):
        """Initialize the manufacturer cluster."""
        super().__init__(*args, **kwargs)
        self._last_stable_position = None
        self._position_samples = []
        self._ignore_until = 0
        self._calibration_mode = False
        self._known_data_points = {}
        self._motor_specs = {
            'default_calibration_time': 30,  # seconds
            'default_motor_speed': 100,      # 1-255 range
            'position_tolerance': 2,         # percentage points
            'movement_timeout': 60           # seconds
        }
        self._calibration_state = {
            'in_progress': False,
            'start_time': None,
            'target_position': None,
            'actual_time': None
        }
        # PERSISTENT FIRMWARE CACHE - survives sleep/wake cycles
        self._firmware_cache = {
            'app_version': None,
            'sw_build_id': None,
            'hw_version': None,
            'date_code': None,
            'cached_time': None
        }
        
    async def bind(self):
        """Bind and set up initial configuration with enhanced discovery."""
        result = await super().bind()
        
        # Enhanced initial setup
        try:
            # 1. Show any previously cached firmware info (non-invasive)
            await self._restore_cached_firmware()
            
            # 2. Read window covering position first (priority)
            window_covering = self.endpoint.window_covering
            if window_covering:
                # Read current position from ZCL attributes
                current_pos = await window_covering.read_attributes(['current_position_lift_percentage'])
                if current_pos and 'current_position_lift_percentage' in current_pos[0]:
                    pos_value = current_pos[0]['current_position_lift_percentage']
                    if pos_value is not None and 0 <= pos_value <= 100:
                        self._last_stable_position = pos_value
                        _LOGGER.info("Initial position read from ZCL: %s%%", pos_value)
            
            # 3. Discover firmware info (after a delay to not interfere with ZHA)
            await __import__('asyncio').sleep(2.0)  # Let ZHA do its thing first
            await self._discover_firmware_version()
                        
            # 4. Request device capabilities discovery
            await self._discover_device_capabilities()
                        
        except Exception as e:
            _LOGGER.debug("Could not complete initial setup: %s", e)
            
        return result
    
    async def _discover_firmware_version(self):
        """Discover and log firmware version from multiple sources."""
        _LOGGER.info("🔍 Discovering firmware version...")
        
        try:
            # Method 1: Basic cluster attributes (READ-ONLY, don't interfere)
            basic_cluster = getattr(self.endpoint, "basic", None)
            if basic_cluster:
                _LOGGER.debug("Reading Basic cluster attributes for firmware info...")
                
                # Read all firmware-related attributes (non-invasive)
                firmware_attrs = [
                    'app_version',          # Application version
                    'sw_build_id',          # Software build ID  
                    'stack_version',        # Stack version
                    'hw_version',           # Hardware version
                    'manufacturer',         # Manufacturer
                    'model',               # Model
                    'date_code',           # Date code
                    'power_source',        # Power source
                ]
                
                for attr_name in firmware_attrs:
                    try:
                        result = await basic_cluster.read_attributes([attr_name])
                        if result and attr_name in result[0]:
                            value = result[0][attr_name]
                            if value is not None and value != 0 and value != '':
                                _LOGGER.warning("📋 %s: %s", attr_name.upper(), value)
                                
                                # CACHE ONLY (don't interfere with ZHA)
                                if attr_name in self._firmware_cache:
                                    self._firmware_cache[attr_name] = value
                                    self._firmware_cache['cached_time'] = __import__('time').time()
                                
                    except Exception as e:
                        _LOGGER.debug("Could not read %s: %s", attr_name, e)
                    
        except Exception as e:
            _LOGGER.debug("Basic cluster firmware discovery failed: %s", e)
        
        # Method 2: Request firmware via Tuya data points
        try:
            _LOGGER.debug("Requesting firmware info via Tuya data points...")
            
            # Reduced list to avoid overwhelming the device
            firmware_dps = [
                (20, "Firmware Version"),
                (21, "Hardware Version"), 
                (24, "MCU Version"),
                (103, "Extended Device Info"),
            ]
            
            for dp, description in firmware_dps:
                try:
                    _LOGGER.debug("Requesting DP %s (%s)", dp, description)
                    # Request the data point (this might trigger a response)
                    await self.tuya_mcu_command(dp, 0, expect_reply=False)
                    await __import__('asyncio').sleep(0.5)  # Longer delay
                except Exception as e:
                    _LOGGER.debug("DP %s request failed: %s", dp, e)
                    
        except Exception as e:
            _LOGGER.debug("Tuya DP firmware discovery failed: %s", e)
            
        _LOGGER.info("✅ Firmware discovery completed - check logs for version info")
    
    async def _restore_cached_firmware(self):
        """Log cached firmware info (non-invasive)."""
        try:
            if any(v is not None for v in self._firmware_cache.values()):
                _LOGGER.info("💾 Previously discovered firmware:")
                
                for attr_name, cached_value in self._firmware_cache.items():
                    if cached_value is not None and attr_name != 'cached_time':
                        _LOGGER.info("💾   %s: %s", attr_name.upper(), cached_value)
                            
                # Log cache age
                if self._firmware_cache['cached_time']:
                    cache_age = __import__('time').time() - self._firmware_cache['cached_time']
                    _LOGGER.info("💾 Cache age: %.1f hours", cache_age / 3600)
            else:
                _LOGGER.debug("No firmware info cached yet")
                    
        except Exception as e:
            _LOGGER.debug("Failed to show cached firmware: %s", e)
    
    def get_cached_firmware_info(self):
        """Return cached firmware information."""
        return {k: v for k, v in self._firmware_cache.items() if v is not None}
    

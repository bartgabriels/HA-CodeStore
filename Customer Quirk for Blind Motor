    async def command(
        self,
        command_id: int,
        *args,
        manufacturer: int | None = None,
        expect_reply: bool = True,
        tsn: int | None = None,
        **kwargs,
    ):
        """Override command to manage position reporting during movements."""
        _LOGGER.debug("TUYA COMMAND - ID: 0x%04x, Args: %s", command_id, args)
        
        # Reset position tracking when new commands are sent
        import time
        self._ignore_until = time.time() + 1.0  # Ignore position updates for 1 second
        self._position_samples.clear()
        
        return await super().command(command_id, *args, manufacturer=manufacturer, 
                                   expect_reply=expect_reply, tsn=tsn, **kwargs)
    
    def handle_cluster_request(
        self,
        hdr: foundation.ZCLHeader,
        args,
        *,
        dst_addressing=None,
    ) -> None:
        """Handle cluster request with improved position validation and DP discovery."""
        if hdr.command_id in (0x0001, 0x0002):  # GET_DATA, SET_DATA_RESPONSE
            if not args or args[0] is None:
                _LOGGER.debug("Received empty or None payload")
                super().handle_cluster_request(hdr, args, dst_addressing=dst_addressing)
                return
                
            tuya_payload = args[0]
            if not hasattr(tuya_payload, 'command_id'):
                _LOGGER.debug("Payload missing command_id attribute")
                super().handle_cluster_request(hdr, args, dst_addressing=dst_addressing)
                return
                
            dp_num = tuya_payload.command_id & 0xFF
            
            # Store all data points we see for calibration discovery
            self._known_data_points[dp_num] = {
                'data': list(tuya_payload.data) if tuya_payload.data else [],
                'function': tuya_payload.function,
                'last_seen': __import__('time').time()
            }
            
            _LOGGER.warning("TUYA DP %s: %s (func: %s)", dp_num, 
                          list(tuya_payload.data) if tuya_payload.data else "None",
                          tuya_payload.function)
            
            # Handle known data points
            if dp_num == 3 and len(tuya_payload.data) >= 5:
                self._handle_position_update(tuya_payload.data[4])
                    
            elif dp_num == 12 and len(tuya_payload.data) >= 2:
                battery_status = tuya_payload.data[1]
                _LOGGER.debug("Battery status: %s", "Good" if battery_status == 0 else "Low")
                
            elif dp_num == 13 and len(tuya_payload.data) >= 5:
                battery_percent = tuya_payload.data[4]
                _LOGGER.debug("Battery: %s%%", battery_percent)
                
                if 0 <= battery_percent <= 100:
                    power_cluster = getattr(self.endpoint, "power", None)
                    if power_cluster:
                        zcl_battery = min(battery_percent * 2, 200)
                        power_cluster._update_attribute(
                            power_cluster.attributes_by_name["battery_percentage_remaining"].id,
                            zcl_battery
                        )
            
            # Handle firmware/device info data points
            elif dp_num in [19, 20, 21, 22, 23, 24, 25, 26, 103, 104, 105, 201, 202]:
                self._handle_firmware_info(dp_num, tuya_payload.data)
            
            # Try to identify calibration data points
            elif dp_num in range(5, 16):  # Common range for calibration DPs
                self._analyze_calibration_dp(dp_num, tuya_payload.data)
        
        # Call the parent handler
        super().handle_cluster_request(hdr, args, dst_addressing=dst_addressing)
    
    def _handle_position_update(self, raw_position: int):
        """Handle position updates with smart filtering and position inversion."""
        import time
        current_time = time.time()
        
        # Ignore updates during command processing
        if current_time < self._ignore_until:
            _LOGGER.debug("Position ignored (command cooldown): %s", raw_position)
            return
            
        # Validate position range
        if not (0 <= raw_position <= 100):
            _LOGGER.debug("Position ignored (invalid range): %s", raw_position)
            return
        
        # POSITION INVERSION: This device reports positions backwards
        # Device: 0-4% = Open, 95-100% = Closed  
        # HA Standard: 0% = Open, 100% = Closed
        # So we need to invert: inverted_position = 100 - raw_position
        inverted_position = 100 - raw_position
        _LOGGER.debug("Position inversion: raw=%s%% -> corrected=%s%%", raw_position, inverted_position)
        
        # Collect position samples for stability checking (use inverted position)
        self._position_samples.append((current_time, inverted_position))
        
        # Keep only recent samples (last 3 seconds)
        self._position_samples = [(t, p) for t, p in self._position_samples if current_time - t < 3.0]
        
        # Need at least 2 samples to check stability
        if len(self._position_samples) < 2:
            return
            
        # Check if position has stabilized
        recent_positions = [p for t, p in self._position_samples if current_time - t < 1.0]
        
        if len(recent_positions) >= 2:
            # Position is stable if recent readings are consistent
            pos_range = max(recent_positions) - min(recent_positions)
            if pos_range <= 2:  # Within 2% tolerance
                stable_position = int(sum(recent_positions) / len(recent_positions))
                
                # Only update if position has actually changed
                if self._last_stable_position is None or abs(stable_position - self._last_stable_position) >= 2:
                    self._update_position(stable_position)
                    self._last_stable_position = stable_position
                    # Clear samples after successful update
                    self._position_samples.clear()
                    
    def _handle_firmware_info(self, dp_num: int, data):
        """Handle firmware and device information data points."""
        if not data:
            return
            
        try:
            # Map DP numbers to their likely content
            dp_descriptions = {
                19: "DEVICE_INFO",
                20: "FIRMWARE_VERSION", 
                21: "HARDWARE_VERSION",
                22: "SOFTWARE_VERSION",
                23: "MODULE_INFO",
                24: "MCU_VERSION",
                25: "WIFI_MODULE",
                26: "DEVICE_STATUS",
                103: "EXTENDED_DEVICE_INFO",
                104: "FIRMWARE_BUILD",
                105: "VERSION_STRING",
                201: "SYSTEM_INFO",
                202: "DEVICE_DETAILS",
            }
            
            description = dp_descriptions.get(dp_num, f"INFO_DP_{dp_num}")
            
            # Try to interpret the data
            if len(data) >= 1:
                data_type = data[0]
                
                if data_type == 0:  # String data
                    try:
                        # Try to decode as string
                        if len(data) > 4:
                            string_data = bytes(data[4:]).decode('utf-8').strip('\x00')
                            if string_data:
                                _LOGGER.warning("🔧 %s (DP %s): '%s'", description, dp_num, string_data)
                    except:
                        # If string decode fails, show as hex
                        hex_data = ' '.join(f'{b:02x}' for b in data[4:] if b != 0)
                        if hex_data:
                            _LOGGER.warning("🔧 %s (DP %s): %s", description, dp_num, hex_data)
                
                elif data_type == 2 and len(data) >= 5:  # Numeric data
                    value = data[4] if len(data) == 5 else int.from_bytes(data[4:], 'big')
                    _LOGGER.warning("🔧 %s (DP %s): %s", description, dp_num, value)
                
                elif data_type == 1 and len(data) >= 5:  # Boolean/enum data
                    value = data[4]
                    _LOGGER.warning("🔧 %s (DP %s): %s", description, dp_num, bool(value))
                
                else:
                    # Unknown format, show raw data
                    raw_data = ' '.join(f'{b:02x}' for b in data)
                    _LOGGER.warning("🔧 %s (DP %s): [%s]", description, dp_num, raw_data)
                    
        except Exception as e:
            _LOGGER.debug("Error parsing firmware info DP %s: %s", dp_num, e)
                    
    def _analyze_calibration_dp(self, dp_num: int, data):
        """Enhanced analysis of calibration-related data points."""
        if not data:
            return
            
        data_len = len(data)
        _LOGGER.warning("CALIBRATION DP %s ANALYSIS: len=%s, data=%s", dp_num, data_len, list(data))
        
        # Store the data point with metadata
        self._known_data_points[dp_num] = {
            'data': list(data),
            'function': getattr(data, 'function', None),
            'last_seen': __import__('time').time(),
            'analysis': self._classify_data_point(dp_num, data)
        }
        
        # Enhanced pattern recognition based on community findings
        if data_len >= 5 and data[0] == 0x02:  # Type 2 = value
            value = data[4] if data_len > 4 else None
            if value is not None:
                analysis = self._classify_calibration_value(dp_num, value)
                _LOGGER.warning("DP %s CLASSIFICATION: %s (value: %s)", dp_num, analysis, value)
    
    def _classify_data_point(self, dp_num: int, data):
        """Classify data point based on patterns and known information."""
        if not data or len(data) < 2:
            return "insufficient_data"
            
        data_type = data[0] if len(data) > 0 else None
        value = data[4] if len(data) > 4 else None
        
        # Enhanced classification based on recent community research
        classifications = {
            # Motor control and calibration (most common)
            5: "motor_speed_primary",
            6: "motor_acceleration", 
            7: "calibration_time_primary",
            8: "calibration_time_secondary",
            9: "motor_direction",
            10: "motor_speed_secondary",
            11: "position_limits",
            
            # Calibration triggers (based on GitHub findings)
            14: "advanced_motor_settings",
            15: "position_calibration",
            16: "calibration_trigger_primary",
            17: "calibration_trigger_secondary", 
            18: "factory_calibration_reset",
            
            # Extended features
            101: "extended_calibration_time",
            102: "motor_characteristics",
        }
        
        base_classification = classifications.get(dp_num, f"unknown_dp_{dp_num}")
        
        # Add value-based refinement
        if value is not None:
            if 5 <= value <= 120:
                return f"{base_classification}_time_range"
            elif 1 <= value <= 255:
                return f"{base_classification}_speed_range"
            elif value in [0, 1]:
                return f"{base_classification}_boolean"
                
        return base_classification
    
    def _classify_calibration_value(self, dp_num: int, value: int):
        """Classify calibration values based on range and context."""
        if 5 <= value <= 120:
            return f"CALIBRATION_TIME_CANDIDATE (DP {dp_num}): {value}s"
        elif 1 <= value <= 255:
            return f"MOTOR_SPEED_CANDIDATE (DP {dp_num}): {value}"
        elif value in [0, 1]:
            return f"BOOLEAN_TRIGGER_CANDIDATE (DP {dp_num}): {value}"
        elif 0 <= value <= 100:
            return f"PERCENTAGE_VALUE (DP {dp_num}): {value}%"
        else:
            return f"UNKNOWN_RANGE (DP {dp_num}): {value}"

    async def set_calibration_time(self, seconds: int):
        """Attempt to set calibration time via various DPs."""
        if not (5 <= seconds <= 120):
            _LOGGER.error("Calibration time must be between 5-120 seconds")
            return foundation.Status.INVALID_VALUE
            
        # Try common data points for calibration time
        for dp_candidate in [7, 8, 9, 10]:
            try:
                _LOGGER.warning("Trying to set calibration time via DP %s to %s seconds", dp_candidate, seconds)
                await self.tuya_mcu_command(dp_candidate, seconds, expect_reply=False)
                await __import__('asyncio').sleep(0.5)  # Small delay between attempts
            except Exception as e:
                _LOGGER.debug("Failed to set calibration via DP %s: %s", dp_candidate, e)
        
        return foundation.Status.SUCCESS
    
    async def set_motor_speed(self, speed: int):
        """Attempt to set motor speed via various DPs."""
        if not (1 <= speed <= 255):
            _LOGGER.error("Motor speed must be between 1-255")
            return foundation.Status.INVALID_VALUE
            
        # Try common data points for motor speed
        for dp_candidate in [5, 6, 14, 15]:
            try:
                _LOGGER.warning("Trying to set motor speed via DP %s to %s", dp_candidate, speed)
                await self.tuya_mcu_command(dp_candidate, speed, expect_reply=False)
                await __import__('asyncio').sleep(0.5)
            except Exception as e:
                _LOGGER.debug("Failed to set motor speed via DP %s: %s", dp_candidate, e)
        
        return foundation.Status.SUCCESS
    
    async def trigger_calibration(self):
        """Attempt to trigger calibration mode."""
        _LOGGER.warning("Attempting to trigger calibration mode...")
        
        # Try common calibration trigger commands
        calibration_commands = [
            (16, 1),   # DP 16, value 1
            (17, 1),   # DP 17, value 1  
            (18, 1),   # DP 18, value 1
            (101, 1),  # DP 101, value 1 (some devices use high DPs)
        ]
        
        for dp, value in calibration_commands:
            try:
                _LOGGER.warning("Trying calibration trigger: DP %s = %s", dp, value)
                await self.tuya_mcu_command(dp, value, expect_reply=False)
                await __import__('asyncio').sleep(1.0)
            except Exception as e:
                _LOGGER.debug("Calibration trigger DP %s failed: %s", dp, e)
        
        return foundation.Status.SUCCESS
    
    def _update_position(self, position: int):
        """Update the ZCL position attribute."""
        try:
            cover_cluster = getattr(self.endpoint, "window_covering", None)
            if cover_cluster:
                # Update the ZCL attribute
                cover_cluster._update_attribute(
                    WindowCovering.AttributeDefs.current_position_lift_percentage.id, 
                    position
                )
                _LOGGER.info("Position updated to %s%%", position)
        except Exception as e:
            _LOGGER.error("Failed to update position: %s", e)
    
    def get_discovered_data_points(self):
        """Return all discovered data points for analysis."""
        return self._known_data_points.copy()

    async def enhanced_calibration_sequence(self, calibration_time: int = None):
        """Enhanced calibration sequence with SAFETY MEASURES to prevent overcalibration."""
        if calibration_time is None:
            # Use conservative default to prevent overcalibration
            calibration_time = min(self._motor_specs['default_calibration_time'], 20)  # Max 20s default
            
        # SAFETY: Cap maximum calibration time to prevent damage
        if calibration_time > 45:
            _LOGGER.warning("Calibration time capped at 45s for safety (requested: %ss)", calibration_time)
            calibration_time = 45
            
        _LOGGER.info("Starting SAFE enhanced calibration sequence (time: %ss)", calibration_time)
        _LOGGER.warning("⚠️  SAFETY NOTICE: Blind will calibrate for MAX %s seconds", calibration_time)
        _LOGGER.warning("⚠️  EMERGENCY STOP: Send 'STOP' command if blind goes too far!")
        
        try:
            # Phase 1: Set CONSERVATIVE calibration time via multiple DPs
            calibration_time_dps = [7, 8, 101]  # Primary candidates
            for dp in calibration_time_dps:
                try:
                    _LOGGER.info("Setting SAFE calibration time (%ss) via DP %s", calibration_time, dp)
                    await self.tuya_mcu_command(dp, calibration_time, expect_reply=False)
                    await __import__('asyncio').sleep(0.5)
                except Exception as e:
                    _LOGGER.debug("DP %s calibration time failed: %s", dp, e)
            
            # Phase 2: Set MODERATE motor speed (prevent aggressive movement)
            motor_speed_dps = [5, 6, 10, 14]  # Speed/acceleration candidates
            # Use 70% of default speed for safer calibration
            safe_speed = int(self._motor_specs['default_motor_speed'] * 0.7)
            for dp in motor_speed_dps:
                try:
                    _LOGGER.info("Setting SAFE motor speed (%s) via DP %s", safe_speed, dp)
                    await self.tuya_mcu_command(dp, safe_speed, expect_reply=False)
                    await __import__('asyncio').sleep(0.5)
                except Exception as e:
                    _LOGGER.debug("DP %s motor speed failed: %s", dp, e)
            
            # Phase 3: Trigger calibration via multiple methods
            calibration_triggers = [
                (16, 1),   # Primary trigger
                (17, 1),   # Secondary trigger
                (18, 1),   # Alternative trigger
                (101, 1),  # Extended trigger
                (102, 0),  # Some devices use 0 to start calibration
            ]
            
            for dp, value in calibration_triggers:
                try:
                    _LOGGER.warning("🔄 TRIGGERING SAFE CALIBRATION: DP %s = %s", dp, value)
                    await self.tuya_mcu_command(dp, value, expect_reply=False)
                    await __import__('asyncio').sleep(1.0)
                except Exception as e:
                    _LOGGER.debug("Calibration trigger DP %s failed: %s", dp, e)
            
            # Phase 4: Start calibration monitoring with timeout
            self._calibration_state['in_progress'] = True
            self._calibration_state['start_time'] = __import__('time').time()
            
            _LOGGER.warning("🔄 SAFE calibration sequence started!")
            _LOGGER.warning("📋 SAFETY INSTRUCTIONS:")
            _LOGGER.warning("  1. Blind will auto-calibrate for MAX %s seconds", calibration_time)
            _LOGGER.warning("  2. Watch for overcalibration - blind should stop at limits")
            _LOGGER.warning("  3. EMERGENCY STOP: Use Home Assistant STOP button if needed")
            _LOGGER.warning("  4. Manual movement may be required during calibration")
            
            # Start safety timeout monitoring
            __import__('asyncio').create_task(self._calibration_safety_monitor(calibration_time + 10))
            
            return foundation.Status.SUCCESS
            
        except Exception as e:
            _LOGGER.error("Safe calibration failed: %s", e)
            self._calibration_state['in_progress'] = False
            return foundation.Status.FAILURE

    async def _calibration_safety_monitor(self, max_duration: int):
        """Monitor calibration and auto-stop if it runs too long."""
        start_time = __import__('time').time()
        
        while self._calibration_state['in_progress']:
            elapsed = __import__('time').time() - start_time
            
            if elapsed > max_duration:
                _LOGGER.error("🛑 SAFETY TIMEOUT: Calibration exceeded %ss - AUTO-STOPPING", max_duration)
                await self.emergency_stop()
                self._calibration_state['in_progress'] = False
                break
                
            await __import__('asyncio').sleep(1)
    
    async def emergency_stop(self):
        """Emergency stop function to halt all movement immediately."""
        _LOGGER.warning("🛑 EMERGENCY STOP ACTIVATED")
        
        try:
            # Send stop command via ZCL
            cover_cluster = getattr(self.endpoint, "window_covering", None)
            if cover_cluster:
                await cover_cluster.stop()
                _LOGGER.info("ZCL stop command sent")
            
            # Send Tuya stop commands to multiple possible DPs
            stop_commands = [
                (1, 2),    # Common stop command
                (2, 2),    # Alternative stop
                (3, 2),    # Position stop
            ]
            
            for dp, value in stop_commands:
                try:
                    await self.tuya_mcu_command(dp, value, expect_reply=False)
                    _LOGGER.info("Tuya stop sent via DP %s", dp)
                except Exception as e:
                    _LOGGER.debug("Stop command DP %s failed: %s", dp, e)
            
            # Reset calibration state
            self._calibration_state['in_progress'] = False
            
            _LOGGER.warning("🛑 Emergency stop sequence completed")
            
        except Exception as e:
            _LOGGER.error("Emergency stop failed: %s", e)

    async def safe_calibration_sequence(self, calibration_time: int = 15):
        """Ultra-safe calibration with very conservative settings."""
        _LOGGER.warning("🔒 Starting ULTRA-SAFE calibration (time: %ss)", calibration_time)
        
        # Force very conservative settings
        safe_time = min(calibration_time, 15)  # Max 15 seconds
        
        _LOGGER.warning("🔒 ULTRA-SAFE MODE: Limited to %s seconds", safe_time)
        _LOGGER.warning("🔒 Lower motor speed, shorter duration")
        
        # Set very conservative motor speed (50% of normal)
        safe_speed = int(self._motor_specs['default_motor_speed'] * 0.5)
        
        try:
            # Set ultra-safe parameters
            await self.tuya_mcu_command(7, safe_time, expect_reply=False)
            await __import__('asyncio').sleep(0.5)
            await self.tuya_mcu_command(10, safe_speed, expect_reply=False)
            await __import__('asyncio').sleep(0.5)
            
            # Trigger calibration
            await self.tuya_mcu_command(16, 1, expect_reply=False)
            
            _LOGGER.warning("🔒 Ultra-safe calibration triggered - monitor closely!")
            
            # Auto-timeout after safe duration
            await __import__('asyncio').sleep(safe_time + 5)
            await self.emergency_stop()
            
            return foundation.Status.SUCCESS
            
        except Exception as e:
            _LOGGER.error("Ultra-safe calibration failed: %s", e)
            return foundation.Status.FAILURE

    async def discover_firmware_info(self):
        """Service command to manually discover firmware information."""
        _LOGGER.warning("🔍 Manual firmware discovery requested")
        await self._discover_firmware_version()
        return foundation.Status.SUCCESS

    async def get_firmware_cache(self):
        """Service command to view cached firmware information."""
        cache_info = self.get_cached_firmware_info()
        if cache_info:
            _LOGGER.warning("💾 CACHED FIRMWARE INFO:")
            for key, value in cache_info.items():
                if key != 'cached_time':
                    _LOGGER.warning("💾   %s: %s", key.upper(), value)
            if 'cached_time' in self._firmware_cache and self._firmware_cache['cached_time']:
                cache_age = __import__('time').time() - self._firmware_cache['cached_time']
                _LOGGER.warning("💾   Cache Age: %.1f hours", cache_age / 3600)
        else:
            _LOGGER.warning("💾 No firmware information cached yet")
        return foundation.Status.SUCCESS


class TuyaBlindWindowCoveringCluster(TuyaWindowCoverControl):
    """Enhanced window covering cluster with ZCL attribute management."""

    _CONSTANT_ATTRIBUTES = {
        WindowCovering.AttributeDefs.window_covering_type.id: WindowCovering.WindowCoveringType.Rollershade,
        WindowCovering.AttributeDefs.config_status.id: 0x03,
        WindowCovering.AttributeDefs.physical_closed_limit_lift.id: 65535,
        WindowCovering.AttributeDefs.installed_closed_limit_lift.id: 65535,
    }
    
    async def bind(self):
        """Set up the cluster with proper attribute initialization."""
        result = await super().bind()
        
        # Initialize position attributes
        try:
            # Set default position if not already set
            current_pos = self._attr_cache.get(WindowCovering.AttributeDefs.current_position_lift_percentage.id)
            if current_pos is None:
                self._update_attribute(WindowCovering.AttributeDefs.current_position_lift_percentage.id, 50)
                _LOGGER.info("Initialized position to 50%")
        except Exception as e:
            _LOGGER.debug("Could not initialize position attributes: %s", e)
            
        return result
    
    async def command(
        self,
        command_id: int,
        *args,
        manufacturer: int | None = None,
        expect_reply: bool = True,
        tsn: int | None = None,
        **kwargs,
    ):
        """Enhanced command handling with position prediction."""
        command_name = {
            0x00: "UP_OPEN",
            0x01: "DOWN_CLOSE", 
            0x02: "STOP"
        }.get(command_id, f"UNKNOWN_0x{command_id:02x}")
        
        _LOGGER.info("Window covering command: %s", command_name)
        
        # Predict position changes for immediate UI feedback
        if command_id in (0x00, 0x01):  # UP or DOWN
            try:
                current_pos = self._attr_cache.get(WindowCovering.AttributeDefs.current_position_lift_percentage.id, 50)
                if command_id == 0x00:  # UP/OPEN
                    predicted_pos = max(0, current_pos - 10)  # Estimate 10% movement
                else:  # DOWN/CLOSE
                    predicted_pos = min(100, current_pos + 10)
                
                # Temporarily update position for immediate feedback
                self._update_attribute(WindowCovering.AttributeDefs.current_position_lift_percentage.id, predicted_pos)
                _LOGGER.debug("Predicted position: %s%%", predicted_pos)
            except Exception as e:
                _LOGGER.debug("Could not predict position: %s", e)
        
        return await super().command(command_id, *args, manufacturer=manufacturer,
                                   expect_reply=expect_reply, tsn=tsn, **kwargs)
    
    async def read_attributes(self, attributes, *args, **kwargs):
        """Enhanced attribute reading with fallback values."""
        result = await super().read_attributes(attributes, *args, **kwargs)
        
        # Provide sensible defaults for unsupported attributes
        if result and isinstance(result, tuple) and len(result) > 0:
            attr_dict = result[0]
            for attr_id in attributes:
                if attr_id not in attr_dict:
                    # Provide defaults for commonly requested attributes
                    if attr_id == WindowCovering.AttributeDefs.current_position_lift_percentage.id:
                        attr_dict[attr_id] = self._attr_cache.get(attr_id, 50)
                    elif attr_id == WindowCovering.AttributeDefs.window_covering_type.id:
                        attr_dict[attr_id] = WindowCovering.WindowCoveringType.Rollershade
                        
        return result


